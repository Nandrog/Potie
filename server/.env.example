PORT=8080
APP_NAME=Arrows Bar

# Supabase > Project Settings > Database > Connection string
# Pooled (Transaction mode, port 6543) – used by the API
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) – used by `prisma db push`
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase > Project Settings > API
SUPABASE_URL=https://<ref>.supabase.co
# SERVER ONLY – never put this key in the Flutter app
SUPABASE_SERVICE_ROLE_KEY=

# Seeded manager (first login). Change the password immediately.
SEED_MANAGER_EMAIL=manager@potie.app
SEED_MANAGER_PASSWORD=Manager@123

# Optional: SMTP used to email login details when the manager has not set it up in the app
# (Gmail: smtp.gmail.com, port 587, an App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
